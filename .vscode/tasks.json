{
    // Build tasks run dev\build.cmd, which sets up the MSVC developer environment
    // and finds Conan itself. So they work even if VS Code was started before
    // Conan or Visual Studio were added to the PATH.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "dev\\build.cmd debug",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
            },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Build Release",
            "type": "shell",
            "command": "dev\\build.cmd release",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
            },
            "group": "build",
            "problemMatcher": ["$msCompile"]
        }
    ]
}
